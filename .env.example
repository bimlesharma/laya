# Public hostname for Let's Encrypt (DNS A/AAAA must point at this VPS).
DOMAIN=laya.example.com

# Shared team bearer token. Generate with: openssl rand -hex 32
LAYA_API_KEY=change-me-to-a-long-random-secret

# CPU profile for a 4-core / 15GB VPS
LAYA_DEVICE=cpu
LAYA_THREADS=4
LAYA_PRELOAD=1
LAYA_MODELS=multilingual

# Image build pins (optional)
TORCH_VERSION=2.14.0
LAYA_VERSION=0.3.22
